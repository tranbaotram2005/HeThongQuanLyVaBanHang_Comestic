@model CategoryUpdateDTO
@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card kpi-card">
            <div class="card-header bg-white font-weight-bold py-3">
                <i class="fas fa-edit text-warning mr-2"></i>Cập nhật danh mục #@ViewBag.CategoryId
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@ViewBag.CategoryId" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="form-group">
                        <label>Tên danh mục *</label>
                        <input asp-for="CategoryName" class="form-control" />
                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-group">
                        <label>Ảnh danh mục</label>
                        @if (!string.IsNullOrEmpty(Model.Picture))
                        {
                            <div class="mb-2">
                                <img src="~/Category/@Model.Picture" alt="@Model.CategoryName"
                                     style="max-height: 90px; object-fit: cover;" class="rounded border p-1" />
                            </div>
                        }
                        <input type="file" name="PictureFile" class="form-control-file mb-2" accept="image/*" />
                        <input asp-for="Picture" class="form-control" placeholder="Tên file trong wwwroot/Category" />
                    </div>

                    <div class="text-right mt-4">
                        <a asp-action="Index" class="btn btn-secondary mr-2">Hủy</a>
                        <button type="submit" class="btn btn-warning px-4">Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
