@model List<CategoryResponseDTO>
@{
    ViewData["Title"] = "Quản lý danh mục";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card kpi-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h6 class="mb-0 font-weight-bold text-dark">
            <i class="fas fa-tags text-info mr-2"></i>Danh sách danh mục (@Model.Count)
        </h6>
        <a asp-action="Create" class="btn btn-success btn-sm">
            <i class="fas fa-plus mr-1"></i> Thêm danh mục
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th style="width: 90px;">Ảnh</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th style="width: 120px;">Trạng thái</th>
                        <th style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        bool isHidden = c.Status == 0;
                        <tr style="@(isHidden ? "opacity: 0.55; background-color: #f1f5f9;" : "")">
                            <td class="align-middle font-weight-bold">#@c.Id</td>
                            <td class="align-middle">
                                @if (!string.IsNullOrEmpty(c.Picture))
                                {
                                    <img src="~/Category/@c.Picture" alt="@c.CategoryName"
                                         style="width: 55px; height: 55px; object-fit: cover;" class="rounded border" />
                                }
                                else
                                {
                                    <span class="text-muted small">Không có</span>
                                }
                            </td>
                            <td class="align-middle font-weight-bold">@c.CategoryName</td>
                            <td class="align-middle text-muted">@c.Description</td>
                            <td class="align-middle">
                                @if (isHidden)
                                {
                                    <span class="badge badge-secondary">Đã ẩn</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Đang hiện</span>
                                }
                            </td>
                            <td class="align-middle">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-warning" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </a>
                                @if (!isHidden)
                                {
                                    <form asp-action="Hide" asp-route-id="@c.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Xác nhận ẩn danh mục này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Ẩn danh mục">
                                            <i class="fas fa-eye-slash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Show" asp-route-id="@c.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Hiện lại danh mục">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
