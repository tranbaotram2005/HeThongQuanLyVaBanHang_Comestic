@model SupplierUpdateDTO
@{
    ViewData["Title"] = "Sửa thương hiệu";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card kpi-card">
            <div class="card-header bg-white font-weight-bold py-3">
                <i class="fas fa-edit text-warning mr-2"></i>Cập nhật thương hiệu #@ViewBag.SupplierId
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@ViewBag.SupplierId" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="form-group">
                        <label>Tên công ty / Thương hiệu *</label>
                        <input asp-for="CompanyName" class="form-control" />
                        <span asp-validation-for="CompanyName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Người liên hệ</label>
                        <input asp-for="ContactName" class="form-control" />
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Số điện thoại</label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <div class="form-group col-md-6">
                            <label>Email</label>
                            <input asp-for="Email" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Logo thương hiệu</label>
                        @if (!string.IsNullOrEmpty(Model.Picture))
                        {
                            <div class="mb-2">
                                <img src="~/Supplier/@Model.Picture" alt="@Model.CompanyName"
                                     style="max-height: 70px; object-fit: contain;" class="border p-1 bg-light rounded" />
                            </div>
                        }
                        <input type="file" name="PictureFile" class="form-control-file mb-2" accept="image/*" />
                        <input asp-for="Picture" class="form-control" placeholder="Tên file trong wwwroot/Supplier" />
                    </div>

                    <div class="text-right mt-4">
                        <a asp-action="Index" class="btn btn-secondary mr-2">Hủy</a>
                        <button type="submit" class="btn btn-warning px-4">Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
