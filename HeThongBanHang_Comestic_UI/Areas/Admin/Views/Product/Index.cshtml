@model List<ProductResponseDTO>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card kpi-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap py-3">
        <h6 class="mb-2 mb-md-0 font-weight-bold text-dark">
            <i class="fas fa-box-open text-primary mr-2"></i>Danh sách sản phẩm (@Model.Count)
        </h6>
        <div class="d-flex align-items-center">
            <form asp-action="Index" method="get" class="form-inline mr-2">
                <div class="input-group input-group-sm">
                    <input type="text" name="query" value="@ViewBag.Query" class="form-control" placeholder="Tìm sản phẩm, danh mục..." />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-outline-primary"><i class="fas fa-search"></i></button>
                    </div>
                </div>
            </form>
            <a asp-action="Create" class="btn btn-success btn-sm">
                <i class="fas fa-plus mr-1"></i> Thêm sản phẩm
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 65px;">ID</th>
                        <th style="width: 75px;">Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục / Thương hiệu</th>
                        <th>Giá bán</th>
                        <th>Tồn kho</th>
                        <th>Trạng thái</th>
                        <th style="width: 170px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        bool isHidden = p.Status == 0;
                        <tr style="@(isHidden ? "opacity: 0.55; background-color: #f1f5f9;" : "")">
                            <td class="align-middle font-weight-bold">#@p.Id</td>
                            <td class="align-middle">
                                <img src="~/Picture/@p.Picture" alt="@p.ProductName"
                                     style="width: 52px; height: 52px; object-fit: contain;" class="border bg-white rounded p-1" />
                            </td>
                            <td class="align-middle">
                                <div class="font-weight-bold">@p.ProductName</div>
                                @if (!string.IsNullOrEmpty(p.Notes))
                                {
                                    <small class="badge badge-light border">@p.Notes</small>
                                }
                            </td>
                            <td class="align-middle">
                                <div>@(p.CategoryName ?? "---")</div>
                                <small class="text-muted">@(p.SupplierName ?? p.Brand ?? "---")</small>
                            </td>
                            <td class="align-middle font-weight-bold text-danger">@((p.UnitPrice ?? 0).ToString("N0")) đ</td>
                            <td class="align-middle text-center">@(p.UnitsInStock ?? 0)</td>
                            <td class="align-middle">
                                @if (isHidden)
                                {
                                    <span class="badge badge-secondary">Đã ẩn</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Đang bán</span>
                                }
                            </td>
                            <td class="align-middle">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </a>
                                @if (!isHidden)
                                {
                                    <form asp-action="Hide" asp-route-id="@p.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Xác nhận ẩn sản phẩm này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Ẩn sản phẩm">
                                            <i class="fas fa-eye-slash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Show" asp-route-id="@p.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Hiện lại sản phẩm">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </form>
                                }
                                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary" title="Xác nhận xóa / ẩn">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
