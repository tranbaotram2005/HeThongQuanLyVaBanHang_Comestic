@model ProductResponseDTO
@{
    ViewData["Title"] = "Xác nhận ẩn sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card kpi-card">
            <div class="card-header bg-danger text-white font-weight-bold py-3">
                <i class="fas fa-trash mr-2"></i>Xác nhận ẩn sản phẩm #@Model.Id
            </div>
            <div class="card-body">
                <h5 class="text-danger mb-3">Bạn có chắc muốn ẩn sản phẩm này khỏi trang bán hàng?</h5>

                <div class="form-group">
                    <label>Tên sản phẩm</label>
                    <input value="@Model.ProductName" class="form-control" disabled />
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label>Giá</label>
                        <input value="@((Model.UnitPrice ?? 0).ToString("N0")) đ" class="form-control" disabled />
                    </div>
                    <div class="form-group col-md-6">
                        <label>Danh mục</label>
                        <input value="@(Model.CategoryName ?? Model.CategoryId?.ToString())" class="form-control" disabled />
                    </div>
                </div>
                <div class="form-group">
                    <label>Ảnh sản phẩm</label><br />
                    <img src="~/Picture/@Model.Picture" style="width:120px;height:120px;object-fit:contain;" class="border rounded bg-white p-1" />
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="text-right mt-4">
                    @Html.AntiForgeryToken()
                    <a asp-action="Index" class="btn btn-secondary mr-2">Quay lại</a>
                    <button type="submit" class="btn btn-danger px-4">Xác nhận ẩn</button>
                </form>
            </div>
        </div>
    </div>
</div>
