@model (string? Opt1Name, string? Opt2Name, string? Opt1Values, string? Opt2Values, bool IsEdit)
@{
    var presets = ViewBag.OptionPresets as List<OptionPresetDTO> ?? new List<OptionPresetDTO>();
}

<div class="p-3 border-bottom bg-light">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
        <span class="font-weight-bold small text-dark">
            <i class="fas fa-tags text-info mr-1"></i>Phân nhóm thuộc tính (chọn từ Option mẫu dùng chung hoặc tự nhập)
            <a asp-controller="OptionPreset" asp-action="Index" target="_blank" class="ml-2 small text-primary">
                <i class="fas fa-cog"></i> Quản lý Option mẫu
            </a>
        </span>
        <button type="button" id="btnGenerateCombos" class="btn btn-sm btn-info mt-1 mt-sm-0">
            <i class="fas fa-magic mr-1"></i>@(Model.IsEdit ? "Thêm tổ hợp còn thiếu" : "Tạo nhanh tổ hợp biến thể")
        </button>
    </div>

    <div class="form-row">
        <div class="col-md-6 mb-2 mb-md-0">
            <div class="input-group input-group-sm mb-1">
                <div class="input-group-prepend">
                    <span class="input-group-text font-weight-bold">Nhóm 1</span>
                </div>
                <select id="opt1PresetSelect" class="form-control preset-select" data-slot="1" style="max-width:170px;">
                    <option value="">-- Option mẫu --</option>
                    @foreach (var p in presets)
                    {
                        if (string.Equals(p.Name, Model.Opt1Name, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@p.Name" selected>@p.Name</option>
                        }
                        else
                        {
                            <option value="@p.Name">@p.Name</option>
                        }
                    }
                </select>
                <input type="text" id="opt1Name" name="Option1Name" value="@Model.Opt1Name"
                       class="form-control" placeholder="Tên nhóm 1 (VD: Dung tích)" />
            </div>
            <input type="text" id="opt1ValuesInput" value="@Model.Opt1Values"
                   class="form-control form-control-sm" placeholder="Giá trị cách dấu , (VD: 30ml, 50ml)" />
            <div id="opt1PresetChips" class="mt-1 d-flex flex-wrap align-items-center"></div>
        </div>

        <div class="col-md-6">
            <div class="input-group input-group-sm mb-1">
                <div class="input-group-prepend">
                    <span class="input-group-text font-weight-bold">Nhóm 2</span>
                </div>
                <select id="opt2PresetSelect" class="form-control preset-select" data-slot="2" style="max-width:170px;">
                    <option value="">-- Option mẫu --</option>
                    @foreach (var p in presets)
                    {
                        if (string.Equals(p.Name, Model.Opt2Name, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@p.Name" selected>@p.Name</option>
                        }
                        else
                        {
                            <option value="@p.Name">@p.Name</option>
                        }
                    }
                </select>
                <input type="text" id="opt2Name" name="Option2Name" value="@Model.Opt2Name"
                       class="form-control" placeholder="Tên nhóm 2 (VD: Mùi hương)" />
            </div>
            <input type="text" id="opt2ValuesInput" value="@Model.Opt2Values"
                   class="form-control form-control-sm" placeholder="Giá trị cách dấu , (VD: Hoa Hồng, Gỗ)" />
            <div id="opt2PresetChips" class="mt-1 d-flex flex-wrap align-items-center"></div>
        </div>
    </div>
</div>

<script>
    window.__optionPresetsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        presets.Select(p => new { name = p.Name, values = p.Values })
    ));
</script>
