@model List<PaymentResponseDTO>
@{
    ViewData["Title"] = ViewBag.OrderId != null ? $"Thanh toán của đơn #{ViewBag.OrderId}" : "Quản lý thanh toán";
    int? orderId = ViewBag.OrderId;
    int? status = ViewBag.Status;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card kpi-card mb-3">
    <div class="card-body py-3">
        <form method="get" class="form-inline">
            <label class="mr-2 font-weight-bold small">Mã đơn hàng:</label>
            <input type="number" name="orderId" value="@orderId" class="form-control form-control-sm mr-3" placeholder="VD: 12" style="width:130px;" />

            <label class="mr-2 font-weight-bold small">Trạng thái:</label>
            <select name="status" class="form-control form-control-sm mr-3">
                <option value="">-- Tất cả --</option>
                <option value="0" selected="@(status == 0)">Chưa thanh toán</option>
                <option value="1" selected="@(status == 1)">Đã thanh toán</option>
                <option value="2" selected="@(status == 2)">Thất bại</option>
                <option value="3" selected="@(status == 3)">Đã hoàn tiền</option>
            </select>

            <button type="submit" class="btn btn-sm btn-primary mr-2">
                <i class="fas fa-filter mr-1"></i>Lọc
            </button>
            @if (orderId.HasValue || status.HasValue)
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Xem tất cả</a>
            }
        </form>
    </div>
</div>

<div class="card kpi-card">
    <div class="card-header bg-white font-weight-bold py-3 d-flex justify-content-between align-items-center">
        <span>
            <i class="fas fa-credit-card text-primary mr-2"></i>
            @(orderId.HasValue ? $"Giao dịch thanh toán của đơn #{orderId}" : "Tất cả giao dịch thanh toán") (@Model.Count)
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>ID</th>
                        <th>Đơn hàng</th>
                        <th>Phương thức</th>
                        <th>Số tiền</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Không có giao dịch thanh toán nào.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var p in Model)
                        {
                            <tr>
                                <td class="align-middle font-weight-bold">#@p.Id</td>
                                <td class="align-middle">
                                    <a asp-controller="Orders" asp-action="Detail" asp-route-id="@p.OrderId" class="font-weight-bold">
                                        Đơn #@p.OrderId
                                    </a>
                                    <a asp-action="Index" asp-route-orderId="@p.OrderId" class="ml-1 badge badge-light border" title="Lọc thanh toán theo đơn này">
                                        <i class="fas fa-filter"></i>
                                    </a>
                                </td>
                                <td class="align-middle">@(p.Method ?? "---")</td>
                                <td class="align-middle text-danger font-weight-bold">@p.Amount.ToString("N0") đ</td>
                                <td class="align-middle small">@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="align-middle">
                                    @switch (p.Status)
                                    {
                                        case 1:<span class="badge badge-success">Đã thanh toán</span>break;
                                        case 2:<span class="badge badge-danger">Thất bại</span>break;
                                        case 3:<span class="badge badge-secondary">Đã hoàn tiền</span>break;
                                        default:<span class="badge badge-warning text-dark">Chưa thanh toán</span>break;
                                    }
                                </td>
                                <td class="align-middle small text-muted">@(p.Notes ?? "-")</td>
                                <td class="align-middle">
                                    <a asp-action="Detail" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye mr-1"></i>Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
