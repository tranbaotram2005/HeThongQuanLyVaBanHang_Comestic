@model OptionPresetFormVM
@{
    ViewData["Title"] = "Cập nhật Option mẫu";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card kpi-card">
            <div class="card-header bg-white font-weight-bold py-3">
                <i class="fas fa-edit text-warning mr-2"></i>Cập nhật Option mẫu #@Model.Id
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="form-group">
                        <label>Tên nhóm thuộc tính *</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Các giá trị gợi ý * (phân cách bằng dấu phẩy hoặc xuống dòng)</label>
                        <textarea asp-for="ValuesText" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="ValuesText" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Mô tả ngắn</label>
                        <input asp-for="Description" class="form-control" />
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">Hiển thị trong danh sách gợi ý khi tạo/sửa sản phẩm</label>
                    </div>

                    <div class="text-right mt-4">
                        <a asp-action="Index" class="btn btn-secondary mr-2">Hủy</a>
                        <button type="submit" class="btn btn-warning px-4">Cập nhật Option mẫu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
