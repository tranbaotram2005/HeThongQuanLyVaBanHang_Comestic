<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Trang Quản Trị") - Comestic Shop</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>
        body {
            background-color: #f4f6f9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }
        .admin-sidebar {
            width: 250px;
            background: #1e293b;
            color: #cbd5e1;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
        }
        .admin-brand {
            padding: 18px 20px;
            font-size: 1.15rem;
            font-weight: 700;
            color: #fff;
            background: #0f172a;
            letter-spacing: 0.5px;
        }
        .admin-nav-label {
            font-size: 0.72rem;
            text-transform: uppercase;
            color: #64748b;
            padding: 16px 20px 6px;
            font-weight: 700;
            letter-spacing: 0.6px;
        }
        .admin-sidebar a.nav-link {
            color: #cbd5e1;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            transition: all 0.15s ease;
            border-left: 3px solid transparent;
        }
        .admin-sidebar a.nav-link i {
            width: 22px;
            margin-right: 10px;
            text-align: center;
        }
        .admin-sidebar a.nav-link:hover,
        .admin-sidebar a.nav-link.active {
            color: #fff;
            background: #334155;
            border-left-color: #ffd333;
        }
        .admin-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }
        .admin-topbar {
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .admin-content {
            padding: 24px;
            flex: 1;
        }
        .kpi-card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
        }
        @@media (max-width: 768px) {
            .admin-sidebar {
                display: none;
                position: fixed;
                z-index: 1050;
                height: 100vh;
            }
            .admin-sidebar.show {
                display: flex;
            }
        }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        @{
            string currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            string currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        }
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-brand">
                <span class="text-warning">COMESTIC</span> ADMIN
            </div>

            <div class="admin-nav-label">Tổng quan</div>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="nav-link @(currentCtrl == "Dashboard" ? "active" : "")">
                <i class="fas fa-tachometer-alt"></i> Dashboard
            </a>

            <div class="admin-nav-label">Đơn hàng</div>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index"
               class="nav-link @(currentCtrl == "Orders" && currentAct != "CreateOrder" ? "active" : "")">
                <i class="fas fa-tasks"></i> Quản lý đơn hàng
            </a>
            <a asp-area="Admin" asp-controller="Orders" asp-action="CreateOrder"
               class="nav-link @(currentCtrl == "Orders" && currentAct == "CreateOrder" ? "active" : "")">
                <i class="fas fa-cart-plus"></i> Đặt đơn dùm khách
            </a>
            <a asp-area="Admin" asp-controller="Payment" asp-action="Index"
               class="nav-link @(currentCtrl == "Payment" ? "active" : "")">
                <i class="fas fa-credit-card"></i> Quản lý thanh toán
            </a>
            <a asp-area="Admin" asp-controller="ShipInfo" asp-action="Index"
               class="nav-link @(currentCtrl == "ShipInfo" ? "active" : "")">
                <i class="fas fa-truck"></i> Quản lý giao hàng
            </a>

            <div class="admin-nav-label">Cửa hàng & Danh mục</div>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index"
               class="nav-link @(currentCtrl == "Product" && currentAct != "Create" ? "active" : "")">
                <i class="fas fa-box-open"></i> Quản lý sản phẩm
            </a>
            <a asp-area="Admin" asp-controller="Product" asp-action="Create"
               class="nav-link @(currentCtrl == "Product" && currentAct == "Create" ? "active" : "")">
                <i class="fas fa-plus-circle"></i> Thêm sản phẩm
            </a>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index"
               class="nav-link @(currentCtrl == "Category" ? "active" : "")">
                <i class="fas fa-tags"></i> Quản lý danh mục
            </a>
            <a asp-area="Admin" asp-controller="Supplier" asp-action="Index"
               class="nav-link @(currentCtrl == "Supplier" ? "active" : "")">
                <i class="fas fa-building"></i> Quản lý thương hiệu
            </a>
            <a asp-area="Admin" asp-controller="OptionPreset" asp-action="Index"
               class="nav-link @(currentCtrl == "OptionPreset" ? "active" : "")">
                <i class="fas fa-sliders-h"></i> Quản lý Option mẫu
            </a>

            <div class="mt-auto p-3 border-top border-secondary">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-warning btn-sm btn-block">
                    <i class="fas fa-store mr-1"></i> Xem trang bán hàng
                </a>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary d-md-none mr-3"
                            onclick="document.getElementById('adminSidebar').classList.toggle('show')">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h5 class="mb-0 font-weight-bold text-dark">@(ViewData["Title"] ?? "Bảng điều khiển")</h5>
                </div>

                <div class="d-flex align-items-center">
                    <span class="mr-3 text-muted small">
                        <i class="fas fa-user-shield text-primary mr-1"></i>
                        <b>@User.Identity?.Name</b>
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge badge-danger ml-1">Admin</span>
                        }
                        else if (User.IsInRole("Employee"))
                        {
                            <span class="badge badge-info ml-1">Employee</span>
                        }
                    </span>

                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-outline-dark mr-2">
                        <i class="fas fa-external-link-alt mr-1"></i> Trang chủ Shop
                    </a>

                    <form asp-area="" asp-controller="Account" asp-action="LogOut" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-sign-out-alt mr-1"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
