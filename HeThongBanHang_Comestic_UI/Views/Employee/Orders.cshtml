@model List<HeThongBanHang_Comestic_UI.DTOs.OrderResponseDTO>

<div class="container-fluid px-xl-5 mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Quản lý đơn hàng</h2>
        <div>
            <a asp-action="CreateOrder" class="btn btn-success btn-sm mr-2">
                <i class="fa fa-plus"></i> Đặt đơn dùm khách
            </a>
            <a asp-controller="OrderDetail" asp-action="MyOrders" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-clipboard-list"></i> Lịch sử đơn của tôi
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

<table class="table table-bordered bg-white">
    <thead class="thead-dark">
        <tr>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th>Hình thức giao/nhận</th>
            <th>Ngày đặt</th>
            <th>Số SP</th>
            <th>Tổng tiền</th>
            <th>Người duyệt</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="align-middle font-weight-bold">#@item.Id</td>

                <td class="align-middle">
                    <div>@(item.CustomerName ?? item.ShipInfos.FirstOrDefault()?.ShipName ?? "---")</div>
                    @if (!string.IsNullOrEmpty(item.EmployeeName))
                    {
                        <span class="badge badge-info">NV đặt dùm: @item.EmployeeName</span>
                    }
                </td>

                <td class="align-middle">
                    @if (!string.IsNullOrEmpty(item.Receive) && (item.Receive.Contains("tại quầy") || item.Receive.Contains("cửa hàng")))
                    {
                        <span class="badge badge-warning text-dark"><i class="fa fa-store"></i> Tại quầy</span>
                    }
                    else
                    {
                        <span class="badge badge-info"><i class="fa fa-truck"></i> @(item.Receive ?? "Giao tận nơi")</span>
                    }
                </td>

                <td class="align-middle">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                <td class="align-middle text-center">@item.OrderDetails.Count</td>

                <td class="align-middle">
                    @item.TotalAmount.ToString("N0") đ
                </td>

                <td class="align-middle">@(item.ApprovedByName ?? "---")</td>

                <td class="align-middle">
                    <a asp-controller="OrderDetail" asp-action="Detail" asp-route-id="@item.Id"
                       class="btn btn-outline-secondary btn-sm mr-1">Chi tiết</a>
                    @if (item.Status == 0)
                    {
                        <a asp-action="ApproveOrder" asp-route-id="@item.Id" asp-route-status="1"
                           class="btn btn-primary btn-sm px-3">Duyệt</a>
                    }
                    else if (item.Status == 1)
                    {
                        <span class="text-info font-weight-bold mr-2">Đã duyệt</span>
                        <a asp-action="ApproveOrder" asp-route-id="@item.Id" asp-route-status="2"
                           class="btn btn-success btn-sm px-3">Hoàn thành</a>
                    }
                    else if (item.Status == 2)
                    {
                        <span class="text-success font-weight-bold"><i class="fa fa-check-circle"></i> Hoàn thành</span>
                    }
                    else
                    {
                        <span class="text-danger font-weight-bold"><i class="fa fa-times-circle"></i> Đã hủy</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>