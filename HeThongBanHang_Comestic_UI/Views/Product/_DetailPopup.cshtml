@using System.Globalization
@model HeThongBanHang_Comestic_UI.Models.ProductDetailVM
@{
    CultureInfo culture = new CultureInfo("vi-VN");
    var defaultVariant = Model.Variants.FirstOrDefault(v => v.IsDefault)
                         ?? Model.Variants.FirstOrDefault();

    var defaultImage = (defaultVariant != null && !string.IsNullOrEmpty(defaultVariant.ImageUrl))
        ? Url.Content("~/ProductVariant/" + defaultVariant.ImageUrl)
        : Url.Content("~/Picture/" + Model.Product.Picture);

    var optionGroups = Model.Variants
        .SelectMany(v => v.Options)
        .GroupBy(kv => kv.Key)
        .ToList();
}
<div class="modal-header border-0">
    <h5 class="modal-title fw-bold">@Model.Product.ProductName</h5>
    <button type="button" class="close" data-dismiss="modal">
        <span>&times;</span>
    </button>
</div>
<div class="modal-body">
    <div class="row">
        <div class="col-md-5 text-center">
            <img id="productImage" src="@defaultImage" class="img-fluid rounded" />
        </div>
        <div class="col-md-7">
            <h4 class="text-danger mb-3">
                <span id="priceDisplay">
                    @((defaultVariant?.Price ?? Model.Product.UnitPrice ?? 0).ToString("N0", culture))
                </span> đ
            </h4>
            <p>@Model.Product.Description</p>

            @foreach (var group in optionGroups)
            {
                <div class="mb-3">
                    <label class="fw-bold">@group.Key</label>
                    <div class="d-flex flex-wrap">
                        @foreach (var val in group.Select(x => x.Value).Distinct())
                        {
                            <button type="button"
                                    class="btn btn-outline-dark option-btn"
                                    data-option="@val"
                                    data-group="@group.Key"
                                    style="margin:5px; border-radius:20px;">
                                @val
                            </button>
                        }
                    </div>
                </div>
            }

            @if (optionGroups.Count == 0 && Model.Variants.Count > 1)
            {
                <div class="mb-3">
                    <label class="fw-bold">Phân loại</label>
                    <div class="d-flex flex-wrap">
                        @foreach (var v in Model.Variants)
                        {
                            <button type="button"
                                    class="btn btn-outline-dark variant-btn @(v.Id == defaultVariant?.Id ? "active" : "")"
                                    data-variant-id="@v.Id"
                                    style="margin:5px; border-radius:20px;">
                                @(string.IsNullOrWhiteSpace(v.Name) ? $"Phân loại #{v.Id}" : v.Name)
                            </button>
                        }
                    </div>
                </div>
            }

            <a href="javascript:void(0)"
               id="addToCartBtn"
               data-variant-id="@(defaultVariant?.Id)"
               class="btn btn-success px-4 mt-3">
                <i class="fa fa-shopping-cart"></i> Add to Cart
            </a>
            <button class="btn btn-secondary px-4 mt-3" data-dismiss="modal">Back</button>
        </div>
    </div>

    <script>
        window.productVariants = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Variants.Select(v => new {
            id = v.Id,
            price = v.Price,
            image = !string.IsNullOrEmpty(v.ImageUrl)
                ? Url.Content("~/ProductVariant/" + v.ImageUrl)
                : Url.Content("~/Picture/" + Model.Product.Picture),
            isDefault = v.IsDefault,
            options = v.Options
        })));
        window.totalGroups = @optionGroups.Count;
        window.isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
    </script>
</div>