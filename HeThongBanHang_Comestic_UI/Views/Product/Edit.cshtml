@model HeThongBanHang_Comestic_UI.DTOs.ProductUpdateDTO
<div class="container mt-4">
    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm border-0 rounded">

                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Edit Product</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Edit" asp-route-id="@ViewBag.ProductId" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Picture" />

                        <!-- Product Name -->
                        <div class="form-group">
                            <label>Tên sản phẩm</label>
                            <input asp-for="ProductName" class="form-control" />
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                        </div>

                        <!-- Price -->
                        <div class="form-group">
                            <label>Giá</label>
                            <input asp-for="UnitPrice" class="form-control" />
                        </div>

                        <!-- Category -->
                        <div class="form-group">
                            <label>Danh mục</label>
                            <select asp-for="CategoryId"
                                    asp-items="@(new SelectList(ViewBag.Categories, "Id", "CategoryName"))"
                                    class="form-control">
                            </select>
                        </div>

                        <!-- Current Image -->
                        <div class="form-group">
                            <label>Ảnh hiện tại</label>
                            <br />
                            <img src="~/Picture/@Model.Picture"
                                 style="width:120px;height:120px;object-fit:cover;"
                                 class="border rounded" />
                        </div>

                        <!-- New Image -->
                        <div class="form-group">
                            <label>Đổi ảnh mới</label>
                            <input type="file" name="ImageFile" class="form-control" />
                        </div>

                        <!-- Description -->
                        <div class="form-group">
                            <label>Mô tả</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Ghi chú / Nhãn khuyến mãi (vd: FlashSale, Combo, FreeGift)</label>
                            <input asp-for="Notes" class="form-control" placeholder="FlashSale / Combo / FreeGift" />
                        </div>

                        <!-- Button -->
                        <div class="text-right">
                            <button type="submit" class="btn btn-primary px-4">
                                Update
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}