@model HeThongBanHang_Comestic_UI.DTOs.ProductCreateDTO
<div class="container mt-4">
    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm border-0 rounded">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create Product</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Create" method="post" enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <!-- Product Name -->
                        <div class="form-group">
                            <label>Tên sản phẩm</label>
                            <input asp-for="ProductName" class="form-control" placeholder="Nhập tên sản phẩm" />
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                        </div>

                        <!-- Price -->
                        <div class="form-group">
                            <label>Giá</label>
                            <input asp-for="UnitPrice" class="form-control" placeholder="Nhập giá" />
                            <span asp-validation-for="UnitPrice" class="text-danger"></span>
                        </div>

                        <!-- Category -->
                        <div class="form-group">
                            <label>Danh mục</label>
                            <select asp-for="CategoryId"
                                    asp-items="@(new SelectList(ViewBag.Categories, "Id", "CategoryName"))"
                                    class="form-control">
                            </select>
                        </div>

                        <!-- Image -->
                        <div class="form-group">
                            <label>Hình ảnh</label>
                            <input type="file" name="ImageFile" class="form-control" />
                        </div>

                        <!-- Description -->
                        <div class="form-group">
                            <label>Mô tả</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Nhập mô tả"></textarea>
                        </div>

                        <div class="form-group">
                            <label>Ghi chú / Nhãn khuyến mãi</label>
                            <input asp-for="Notes" class="form-control" placeholder="FlashSale / Combo / FreeGift" />
                        </div>

                        <!-- Button -->
                        <div class="text-right">
                            <button type="submit" class="btn btn-success px-4">
                                Create
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}