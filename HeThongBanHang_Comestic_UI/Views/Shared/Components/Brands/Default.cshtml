@model IEnumerable<HeThongBanHang_Comestic_UI.DTOs.SupplierResponseDTO>

<nav class="collapse position-absolute navbar navbar-vertical navbar-light align-items-start p-0 bg-light" id="navbar-vertical" style="width: calc(100% - 30px); z-index: 999;">
    <div class="navbar-nav w-100">
        <a asp-controller="Product" asp-action="Index" asp-route-sort="newest" class="nav-item nav-link">
            New Arrivals
        </a>

        <div class="nav-item dropdown dropright">
            <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">
                Promotions <i class="fa fa-angle-right float-right mt-1"></i>
            </a>
            <div class="dropdown-menu position-absolute rounded-0 border-0 m-0">
                <a asp-controller="Product" asp-action="Index" asp-route-sort="flashsale" class="dropdown-item">Flash Sale</a>
                <a asp-controller="Product" asp-action="Index" asp-route-query="Combo" class="dropdown-item">Combo Deals</a>
                <a asp-controller="Product" asp-action="Index" asp-route-sort="newest" class="dropdown-item">Free Gifts</a>
            </div>
        </div>

        <div class="nav-item dropdown dropright">
            <a href="#" class="nav-link dropdown-toggle" data-toggle="dropdown">
                Brands <i class="fa fa-angle-right float-right mt-1"></i>
            </a>
            <div class="dropdown-menu position-absolute rounded-0 border-0 m-0">
                @foreach (var s in Model)
                {
                    <a asp-controller="Product" asp-action="Index" asp-route-supplierId="@s.Id" class="dropdown-item">
                        @s.CompanyName
                    </a>
                }
            </div>
        </div>
    </div>
</nav>