@model HeThongBanHang_Comestic_UI.Models.CartModel
<a asp-controller="Cart" asp-action="Index" class="btn px-0 ml-3">
    <i class="fas fa-shopping-cart text-primary"></i>

    <span class="cart-count badge text-secondary border border-secondary rounded-circle">
        @Model.quantity
    </span>
</a>