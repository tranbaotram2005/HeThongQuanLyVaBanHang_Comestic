@model IEnumerable<HeThongBanHang_Comestic_UI.Models.MenuPrice>

@{
    var minSelected = Context.Request.Query["minPrice"].ToString();
    var maxSelected = Context.Request.Query["maxPrice"].ToString();
}

<h5 class="section-title position-relative text-uppercase mb-3">
    <span class="bg-secondary pr-3">Lọc theo giá</span>
</h5>

<div class="bg-light p-4 mb-30">

    @foreach (var item in Model)
    {
        var isActive =
        minSelected == item.minPrice.ToString() &&
        maxSelected == item.maxPrice.ToString();

        <a asp-controller="Product"
           asp-action="Index"
           asp-route-loai="@Context.Request.Query["loai"]"
           asp-route-minPrice="@item.minPrice"
           asp-route-maxPrice="@item.maxPrice"
           class="d-flex justify-content-between align-items-center p-2 mb-2 rounded
           text-dark text-decoration-none price-filter-item
           @(isActive ? "bg-primary text-white font-weight-bold" : "bg-white")"
           style="transition: all 0.2s;">

            <span>
                @if (isActive)
                {
                    <i class="fa fa-check mr-2"></i>
                }
                @item.label
            </span>

        </a>
    }

    <a asp-controller="Product"
       asp-action="Index"
       asp-route-loai="@Context.Request.Query["loai"]"
       class="d-flex justify-content-center align-items-center p-2 mt-3 rounded
              bg-light border text-dark text-decoration-none">

        <i class="fa fa-times mr-2"></i> All
    </a>

</div>