@{
    ViewData["Title"] = "Thanh toán thất bại";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <h2 class="text-danger mb-3">Thanh toán chưa hoàn tất</h2>
                    <p class="mb-4">
                        Giao dịch của bạn đã bị hủy hoặc chưa được xác nhận thanh toán.
                        Vui lòng kiểm tra lại trong lịch sử đơn hàng hoặc thử thanh toán lại.
                    </p>
                    <div class="d-grid gap-2">
                        <a asp-controller="OrderDetail" asp-action="MyOrders" class="btn btn-danger">Xem đơn hàng của tôi</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Quay về trang chủ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>