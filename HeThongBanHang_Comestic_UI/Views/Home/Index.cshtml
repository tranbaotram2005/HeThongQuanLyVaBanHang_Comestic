<!-- Vendor Start -->
<div class="container-fluid py-5">
    @if (isStaff)
    {
        <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4 d-flex justify-content-between align-items-center">
            <span class="bg-secondary pr-3">Thương hiệu</span>
            <a asp-controller="Supplier" asp-action="Create" class="btn btn-sm btn-success" title="Thêm thương hiệu">
                <i class="fa fa-plus"></i> Thêm thương hiệu
            </a>
        </h2>
    }
    <div class="row px-xl-5">
        <div class="col">
            <div class="owl-carousel vendor-carousel">
                @foreach (var supplier in Model.Suppliers)
                {
                    bool isSupplierHidden = supplier.Status == 0;
                    <div class="bg-light p-4 position-relative d-flex align-items-center justify-content-center"
                         style="height: 120px; @(isSupplierHidden ? "opacity: 0.45; filter: grayscale(100%); background-color: #e9ecef !important;" : "")">

                        <a href="@Url.Action("Index", "Product", new { supplierId = supplier.Id })"
                           class="text-decoration-none d-flex flex-column align-items-center justify-content-center w-100 h-100"
                           title="@supplier.CompanyName">
                            @if (!string.IsNullOrEmpty(supplier.Picture))
                            {
                                <img src="~/Supplier/@supplier.Picture" alt="@supplier.CompanyName"
                                     style="max-height: 75px; max-width: 100%; width: auto; object-fit: contain;" />
                            }
                            else
                            {
                                <span class="font-weight-bold text-dark text-center">@supplier.CompanyName</span>
                            }
                            @if (isSupplierHidden)
                            {
                                <span class="badge badge-secondary mt-1">Đã ẩn</span>
                            }
                        </a>

                        @if (isStaff)
                        {
                            <div class="position-absolute" style="top: 6px; right: 8px; z-index: 5;">
                                <a asp-controller="Supplier" asp-action="Create"
                                   class="btn btn-xs btn-outline-success p-1" title="Thêm mới">
                                    <i class="fa fa-plus"></i>
                                </a>
                                <a asp-controller="Supplier" asp-action="Edit" asp-route-id="@supplier.Id"
                                   class="btn btn-xs btn-outline-warning p-1" title="Sửa">
                                    <i class="fa fa-edit"></i>
                                </a>
                                @if (!isSupplierHidden)
                                {
                                    <form asp-controller="Supplier" asp-action="Hide" asp-route-id="@supplier.Id"
                                          asp-route-returnUrl="/" method="post" class="d-inline"
                                          onsubmit="return confirm('Xác nhận ẩn thương hiệu này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-xs btn-outline-danger p-1" title="Ẩn thương hiệu">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Supplier" asp-action="Show" asp-route-id="@supplier.Id"
                                          asp-route-returnUrl="/" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-xs btn-outline-primary p-1" title="Hiện lại thương hiệu">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- Vendor End -->
